#database
POSTGRES_URL=jdbc:postgresql://localhost:5432
POSTGRES_DB={database_name}
POSTGRES_USER={database_user}
POSTGRES_PASSWORD={database_password}

#auth
AUTH_ACCESS_SECRET={access_token_secret}
AUTH_REFRESH_SECRET={refresh_token_secret}
REGISTER_CODE_HASH_SECRET={register_code_hash_secret}

#storage
STORAGE_ENGINE=local
STORAGE_LOCAL_BASE_DIR=./.local-storage
STORAGE_LOCAL_PUBLIC_BASE_URL=
STORAGE_LOCAL_TEMP_URL_SECRET={local_temp_url_secret}
STORAGE_LOCAL_DEFAULT_TTL=5m

#ai
AI_PROVIDER=ollama
AI_MODEL=llama3.1
AI_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# resume mq
RESUME_MQ_STREAM_KEY=resumer.resume.analysis.v1
RESUME_MQ_DLQ_STREAM_KEY=resumer.resume.analysis.v1.dlq
RESUME_MQ_GROUP_NAME=resume-analysis-workers
